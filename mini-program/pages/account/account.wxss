.profile-hero {
  background: #ffffff;
  padding: 40rpx 48rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 56rpx;
  background: #1b4b8a;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.profile-meta {
  flex: 1;
}

.employee-no {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #1b4b8a;
}

.btn-ghost {
  margin-top: 32rpx;
}

.field {
  margin-top: 24rpx;
}

.help-text {
  margin: 16rpx 0;
}
