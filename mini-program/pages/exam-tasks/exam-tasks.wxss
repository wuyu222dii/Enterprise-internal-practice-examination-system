.task-item {
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.task-title {
  font-weight: 500;
}

.task-status {
  font-size: 24rpx;
  color: #6b7c93;
}

.error {
  color: #c0392b;
  margin-bottom: 16rpx;
}

.stub {
  color: #6b7c93;
  margin-bottom: 24rpx;
}
