<view class="container">
  <view class="card">
    <view class="title">学习记录</view>
    <view class="subtitle">练习、模拟与正式考试提交事实</view>

    <view class="tabs">
      <view class="tab {{tab === 'practice' ? 'active' : ''}}" data-tab="practice" bindtap="onTabChange">练习</view>
      <view class="tab {{tab === 'mock' ? 'active' : ''}}" data-tab="mock" bindtap="onTabChange">模拟</view>
      <view class="tab {{tab === 'exam' ? 'active' : ''}}" data-tab="exam" bindtap="onTabChange">正式考试</view>
    </view>

    <view wx:if="{{loading}}">加载中…</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>

    <view wx:if="{{tab === 'practice'}}">
      <view
        wx:for="{{practiceRecords}}"
        wx:key="id"
        class="record-item"
        data-id="{{item.id}}"
        data-status="{{item.status}}"
        bindtap="onOpenPracticeReview"
      >
        <view class="record-title">练习 · {{item.questionCount}} 题</view>
        <view class="record-meta">{{item.status}} · {{item.mode}} · {{item.createdAt}}</view>
      </view>
      <view wx:if="{{!loading && practiceRecords.length === 0}}" class="stub">暂无练习记录</view>
    </view>

    <view wx:if="{{tab === 'mock'}}">
      <view
        wx:for="{{mockRecords}}"
        wx:key="id"
        class="record-item"
        data-id="{{item.id}}"
        data-status="{{item.status}}"
        bindtap="onOpenMockReview"
      >
        <view class="record-title">模拟 · {{item.questionCount}} 题</view>
        <view class="record-meta">{{item.status}} · {{item.durationMinutes}} 分钟 · {{item.startedAt}}</view>
      </view>
      <view wx:if="{{!loading && mockRecords.length === 0}}" class="stub">暂无模拟记录</view>
    </view>

    <view wx:if="{{tab === 'exam'}}">
      <view
        wx:for="{{examRecords}}"
        wx:key="attemptId"
        class="record-item"
        data-id="{{item.attemptId}}"
        data-review="{{item.canReview ? 1 : 0}}"
        bindtap="onOpenExamReview"
      >
        <view class="record-title">{{item.examTitle || '正式考试'}}</view>
        <view class="record-meta">{{item.lifecycleLabel}} · {{item.fact}}</view>
        <view class="record-meta" wx:if="{{item.submittedAtText}}">提交时间 {{item.submittedAtText}}</view>
        <view class="record-meta" wx:if="{{item.summary}}">{{item.summary}}</view>
        <view class="record-notice" wx:if="{{item.notice}}">{{item.notice}}</view>
      </view>
      <view wx:if="{{!loading && examRecords.length === 0}}" class="stub">暂无正式考试记录</view>
    </view>

    <navigator url="/pages/account/account" open-type="switchTab" class="back-link">返回我的</navigator>
  </view>
</view>
