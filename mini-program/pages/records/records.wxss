.tabs {
  display: flex;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  color: #6b7c93;
}

.tab.active {
  color: #1b4b8a;
  font-weight: 600;
  border-bottom: 4rpx solid #1b4b8a;
}

.record-item {
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.record-title {
  font-weight: 500;
  margin-bottom: 8rpx;
}

.record-meta {
  font-size: 24rpx;
  color: #6b7c93;
}

.back-link {
  display: block;
  margin-top: 24rpx;
  color: #1b4b8a;
  text-align: center;
}

.error {
  color: #c0392b;
  margin-bottom: 16rpx;
}

.stub {
  color: #6b7c93;
  margin-bottom: 24rpx;
}
