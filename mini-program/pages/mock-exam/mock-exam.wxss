.header-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.progress,
.timer {
  font-size: 24rpx;
  color: #6b7c93;
}

.timer {
  color: #c0392b;
}

.stem {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.essay-input {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.score-hint {
  font-size: 24rpx;
  color: #6b7c93;
  margin-bottom: 24rpx;
}

.option {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
  border: 2rpx solid #e5e7eb;
  color: #1f2937;
}

.option.selected {
  border-color: #1b4b8a;
  background: #e8f0f8;
  color: #1b4b8a;
}

.option-key {
  width: 40rpx;
  margin-right: 16rpx;
  font-weight: 600;
}

.option-text {
  flex: 1;
}

.nav-row {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0;
}

.submit-btn {
  margin-top: 16rpx;
}

.score {
  font-size: 40rpx;
  font-weight: 600;
  color: #1b4b8a;
  margin: 24rpx 0;
}

.error {
  color: #c0392b;
}
