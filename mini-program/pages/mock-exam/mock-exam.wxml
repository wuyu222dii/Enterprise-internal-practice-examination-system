<view class="container">
  <view class="card" wx:if="{{loading}}">加载中…</view>
  <view class="card" wx:if="{{error}}">
    <view class="error">{{error}}</view>
    <navigator url="/pages/mock/mock">返回模拟</navigator>
  </view>

  <view class="card" wx:if="{{currentItem && !submitted && !loading}}">
    <view class="header-row">
      <text class="progress">第 {{currentIndex + 1}} / {{paper.items.length}} 题</text>
      <text class="timer">剩余 {{remainingSeconds}}s</text>
    </view>
    <view class="stem">{{currentItem.stem}}</view>
    <view class="score-hint">本题 {{currentItem.score}} 分</view>

    <textarea
      wx:if="{{isEssay}}"
      class="essay-input"
      value="{{essayText}}"
      placeholder="请输入解答内容"
      maxlength="-1"
      auto-height
      bindinput="onEssayInput"
    />

    <block wx:else>
      <view
        wx:for="{{displayOptions}}"
        wx:key="key"
        class="option {{item.state}}"
        data-key="{{item.key}}"
        bindtap="onSelectOption"
      >
        <text class="option-key">{{item.key}}</text>
        <text class="option-text">{{item.text}}</text>
      </view>
    </block>

    <view class="nav-row">
      <button size="mini" disabled="{{currentIndex <= 0}}" bindtap="onPrev">上一题</button>
      <button size="mini" disabled="{{currentIndex >= paper.items.length - 1}}" bindtap="onNext">下一题</button>
    </view>

    <button class="btn-primary submit-btn" loading="{{submitting}}" bindtap="onSubmitExam">交卷</button>
    <button class="btn-danger" loading="{{submitting}}" bindtap="onAbandon">放弃模拟</button>
  </view>
</view>
