.progress {
  font-size: 24rpx;
  color: #6b7c93;
  margin-bottom: 16rpx;
}

.stem {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.option {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
  border: 2rpx solid #e5e7eb;
  color: #1f2937;
}

.option.selected {
  border-color: #1b4b8a;
  background: #e8f0f8;
  color: #1b4b8a;
}

.option.correct {
  border-color: #16a34a;
  background: #f0fdf4;
  color: #166534;
}

.option.wrong {
  border-color: #dc2626;
  background: #fef2f2;
  color: #991b1b;
}

.option-key {
  width: 40rpx;
  margin-right: 16rpx;
  font-weight: 600;
}

.option-text {
  flex: 1;
}

.feedback {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 8rpx;
}

.feedback.correct {
  background: #e8f8ef;
}

.feedback.wrong {
  background: #fdecea;
}

.feedback-title {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.error {
  color: #c0392b;
}
