<view class="page">
  <view class="header">
    <view class="header-title">你好，{{displayName}}</view>
    <view class="header-sub">工号 {{employeeNo}}{{bankName ? '  ·  ' + bankName : ''}}</view>
  </view>

  <view class="body">
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view wx:if="{{loading}}" class="stub">加载中…</view>

    <view wx:if="{{activeSession}}" class="continue-card" bindtap="onContinue">
      <view class="continue-copy">
        <view class="continue-title">继续上次{{modeLabel}}</view>
        <view class="continue-meta">第 {{activeSession.currentIndex || 1}} / {{activeSession.questionCount}} 题</view>
      </view>
      <text class="chevron">›</text>
    </view>

    <view wx:if="{{activeMock}}" class="continue-card" bindtap="onContinueMock">
      <view class="continue-copy">
        <view class="continue-title">继续进行中的模拟</view>
        <view class="continue-meta">{{activeMock.questionCount}} 题 · {{activeMock.durationMinutes}} 分钟</view>
      </view>
      <text class="chevron">›</text>
    </view>

    <view wx:if="{{bankName}}" class="card">
      <view class="bank-top">
        <view class="card-title bank-title">{{bankName}}</view>
        <view class="tag">默认题库</view>
      </view>
      <view class="card-meta">选择题库后开始练习，不计入正式成绩</view>
    </view>
    <view wx:elif="{{!loading}}" class="card">
      <view class="card-title">暂无开放练习的题库</view>
      <view class="card-meta">请联系管理员开放练习题库</view>
    </view>

    <view class="grid">
      <view class="grid-item">
        <view class="mode-card" bindtap="onStartMode" data-mode="sequential">
          <image class="mode-icon" src="/assets/tab/mode-sequential.png" mode="aspectFit" />
          <view class="mode-title">顺序练习</view>
          <view class="mode-sub">按题库顺序作答</view>
        </view>
      </view>
      <view class="grid-item">
        <view class="mode-card" bindtap="onStartMode" data-mode="random">
          <image class="mode-icon" src="/assets/tab/mode-random.png" mode="aspectFit" />
          <view class="mode-title">随机练习</view>
          <view class="mode-sub">打乱题目顺序</view>
        </view>
      </view>
      <view class="grid-item">
        <view class="mode-card" bindtap="onOpenConfig">
          <image class="mode-icon" src="/assets/tab/mode-topic.png" mode="aspectFit" />
          <view class="mode-title">专项练习</view>
          <view class="mode-sub">按知识点筛选</view>
        </view>
      </view>
      <view class="grid-item">
        <view class="mode-card" bindtap="onWrongBook">
          <image class="mode-icon" src="/assets/tab/mode-wrong.png" mode="aspectFit" />
          <view class="mode-title">错题练习</view>
          <view class="mode-sub">重做历史错题</view>
        </view>
      </view>
    </view>

    <view wx:if="{{examTodos.length > 0}}" class="card exam-todo">
      <view class="card-title">正式考试待办</view>
      <view class="card-meta">仅查看任务与考试码，正式开卷请使用电脑端</view>
      <view
        wx:for="{{examTodos}}"
        wx:key="id"
        class="todo-item"
        data-id="{{item.id}}"
        bindtap="onOpenExamTodo"
      >
        <view class="todo-title">{{item.title}}</view>
        <view class="domain-row">
          <view class="domain-cell"><text class="dt">生命周期</text><text class="dd">{{item.domain.lifecycle}}</text></view>
          <view class="domain-cell"><text class="dt">运行</text><text class="dd">{{item.domain.run}}</text></view>
          <view class="domain-cell"><text class="dt">参与</text><text class="dd">{{item.domain.participation}}</text></view>
          <view class="domain-cell"><text class="dt">尝试</text><text class="dd">{{item.domain.attempt}}</text></view>
          <view class="domain-cell"><text class="dt">结果</text><text class="dd">{{item.domain.result}}</text></view>
        </view>
        <view class="todo-meta" wx:if="{{item.examCode}}">考试码 {{item.examCode}}</view>
      </view>
    </view>
  </view>
</view>
