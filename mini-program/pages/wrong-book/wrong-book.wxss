.entry-item {
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.entry-title {
  font-weight: 500;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.entry-meta {
  font-size: 24rpx;
  color: #6b7c93;
}

.summary {
  font-size: 24rpx;
  color: #6b7c93;
  margin-bottom: 16rpx;
}

.back-link {
  display: block;
  margin-top: 24rpx;
  color: #1b4b8a;
  text-align: center;
}

.error {
  color: #c0392b;
  margin-bottom: 16rpx;
}

.stub {
  color: #6b7c93;
  margin-bottom: 24rpx;
}
