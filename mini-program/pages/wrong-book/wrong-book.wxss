.entry-item {
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.entry-title {
  font-weight: 500;
  margin-bottom: 8rpx;
  word-break: break-word;
  white-space: pre-wrap;
}

.field {
  margin: 16rpx 0 24rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #6b7c93;
  margin-bottom: 8rpx;
}

.btn-primary {
  background: #1b4b8a;
  color: #fff;
  margin-bottom: 24rpx;
}

.btn-text {
  color: #1b4b8a;
  padding: 0;
  margin-top: 8rpx;
}

.entry-meta {
  font-size: 24rpx;
  color: #6b7c93;
}

.summary {
  font-size: 24rpx;
  color: #6b7c93;
  margin-bottom: 16rpx;
}

.back-link {
  display: block;
  margin-top: 24rpx;
  color: #1b4b8a;
  text-align: center;
}

.error {
  color: #c0392b;
  margin-bottom: 16rpx;
}

.stub {
  color: #6b7c93;
  margin-bottom: 24rpx;
}
