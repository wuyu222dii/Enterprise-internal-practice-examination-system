<view class="container">
  <view class="card">
    <view class="title">练习模式</view>
    <view class="subtitle">MP-03 选择题库开始练习</view>

    <view wx:if="{{loading}}">加载中…</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>

    <view wx:if="{{activeSession}}" class="active-box">
      <view class="active-title">进行中的练习</view>
      <view class="active-meta">{{activeSession.questionCount}} 题 · {{activeSession.mode}}</view>
      <button class="btn-primary" bindtap="onContinue">继续练习</button>
    </view>

    <view wx:if="{{!loading && banks.length === 0}}" class="stub">暂无开放练习的题库</view>

    <view wx:if="{{banks.length > 0}}">
      <view class="label">选择题库</view>
      <picker mode="selector" range="{{banks}}" range-key="name" bindchange="onBankChange">
        <view class="picker">{{selectedBankName || '请选择题库'}}</view>
      </picker>

      <view class="label">题量</view>
      <picker mode="selector" range="{{['10题','20题','50题']}}" bindchange="onCountChange">
        <view class="picker">{{questionCount}} 题</view>
      </picker>

      <button class="btn-primary" loading="{{starting}}" bindtap="onStart">开始练习</button>
    </view>

    <navigator url="/pages/home/home" open-type="navigateBack" class="back-link">返回首页</navigator>
  </view>
</view>
