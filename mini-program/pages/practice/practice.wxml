<view class="page">
    <view class="header">
      <view class="header-title">{{modeTitle}}</view>
      <view class="header-sub">{{mode === 'targeted' ? '专项练习 · 按分类/知识点筛选' : '选择题库与题量后开始'}}，不计入正式成绩</view>
    </view>
  <view class="body">
    <view wx:if="{{loading}}" class="stub">加载中…</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>

    <view wx:if="{{activeSession}}" class="continue-card" bindtap="onContinue">
      <view>
        <view class="continue-title">继续进行中的练习</view>
        <view class="continue-meta">{{activeSession.questionCount}} 题 · {{activeSession.mode}}</view>
      </view>
      <text class="chevron">›</text>
    </view>

    <view wx:if="{{!loading && banks.length === 0}}" class="card">
      <view class="card-title">暂无开放练习的题库</view>
    </view>

    <view wx:if="{{banks.length > 0}}" class="card">
      <view class="field">
        <text class="field-label">选择题库</text>
        <picker mode="selector" range="{{banks}}" range-key="name" bindchange="onBankChange">
          <view class="field-input picker-value">{{selectedBankName || '请选择题库'}}</view>
        </picker>
      </view>
      <view wx:if="{{mode === 'targeted'}}" class="field">
        <text class="field-label">分类</text>
        <picker mode="selector" range="{{categoryNames}}" bindchange="onCategoryChange">
          <view class="field-input picker-value">{{selectedCategoryName}}</view>
        </picker>
      </view>
      <view wx:if="{{mode === 'targeted'}}" class="field">
        <text class="field-label">知识点</text>
        <picker mode="selector" range="{{kpNames}}" bindchange="onKpChange">
          <view class="field-input picker-value">{{selectedKpName}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">题量</text>
        <picker mode="selector" range="{{countLabels}}" bindchange="onCountChange">
          <view class="field-input picker-value">{{questionCount}} 题</view>
        </picker>
      </view>
      <view wx:if="{{mode === 'sequential'}}" class="field" bindtap="onToggleRestart">
        <text class="field-label">长期进度</text>
        <view class="field-input picker-value">{{restartRound ? '重新开始一轮' : (sequentialRestartAvailable ? '从上次进度继续' : '按题库顺序续做')}}</view>
      </view>
      <button class="btn-primary" loading="{{starting}}" bindtap="onStart">开始练习</button>
      <view class="card-meta summary-line">本题量 {{questionCount}} 题{{mode === 'targeted' ? ' · ' + selectedCategoryName + ' · ' + selectedKpName : ''}}</view>
    </view>
  </view>
</view>
