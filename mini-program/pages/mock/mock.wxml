<view class="page">
  <view class="header">
    <view class="header-title">模拟考试</view>
    <view class="header-sub">固定试卷 · 计时作答 · 不计入正式成绩</view>
  </view>
  <view class="body">
    <view wx:if="{{loading}}" class="stub">加载中…</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>

    <view wx:if="{{activeAttempt}}" class="continue-card" bindtap="onContinue">
      <view>
        <view class="continue-title">继续进行中的模拟</view>
        <view class="continue-meta">{{activeAttempt.questionCount}} 题 · {{activeAttempt.durationMinutes}} 分钟</view>
      </view>
      <text class="chevron">›</text>
    </view>

    <view wx:if="{{!loading && banks.length === 0}}" class="card">
      <view class="card-title">暂无开放模拟的题库</view>
      <view class="card-meta">请联系管理员开放模拟题库</view>
    </view>

    <view wx:if="{{banks.length > 0}}" class="card">
      <view class="field">
        <text class="field-label">选择题库</text>
        <picker mode="selector" range="{{banks}}" range-key="name" bindchange="onBankChange">
          <view class="field-input picker-value">{{selectedBankName || '请选择题库'}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">题量</text>
        <picker mode="selector" range="{{['10题','20题','50题']}}" bindchange="onCountChange">
          <view class="field-input picker-value">{{questionCount}} 题</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">时长</text>
        <picker mode="selector" range="{{['30分钟','60分钟','90分钟']}}" bindchange="onDurationChange">
          <view class="field-input picker-value">{{durationMinutes}} 分钟</view>
        </picker>
      </view>
      <button class="btn-primary" loading="{{starting}}" bindtap="onStart">开始模拟</button>
    </view>
  </view>
</view>
