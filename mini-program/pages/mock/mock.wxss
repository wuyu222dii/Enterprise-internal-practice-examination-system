.label {
  font-size: 26rpx;
  color: #6b7c93;
  margin: 16rpx 0 8rpx;
}

.picker {
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.active-box {
  padding: 24rpx;
  background: #eef3fa;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.active-title {
  font-weight: 500;
  margin-bottom: 8rpx;
}

.active-meta {
  font-size: 24rpx;
  color: #6b7c93;
  margin-bottom: 16rpx;
}

.back-link {
  display: block;
  margin-top: 24rpx;
  color: #1b4b8a;
  text-align: center;
}

.error {
  color: #c0392b;
  margin-bottom: 16rpx;
}

.stub {
  color: #6b7c93;
  margin-bottom: 24rpx;
}
