page {
  background-color: #f5f7fa;
  color: #2c3e50;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(27, 75, 138, 0.08);
}

.btn-primary {
  background-color: #1b4b8a;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #6b7c93;
  margin-bottom: 24rpx;
}
