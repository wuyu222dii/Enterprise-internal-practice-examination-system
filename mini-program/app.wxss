page {
  background-color: #f5f7fa;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.5;
  --color-primary: #1b4b8a;
  --color-bg: #f5f7fa;
  --color-danger: #dc2626;
  --color-warning: #d97706;
  --color-success: #16a34a;
}

.page {
  min-height: 100vh;
  background-color: #f5f7fa;
}

.hero {
  background: #ffffff;
  padding: 72rpx 48rpx 16rpx;
}

.brand-mark {
  width: 66rpx;
  height: 56rpx;
  background: #1b4b8a;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.2;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.form {
  background: #ffffff;
  padding: 56rpx 48rpx 48rpx;
}

.field {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  background: #ffffff;
}

.btn-primary {
  background-color: #1b4b8a;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-primary::after {
  border: none;
}

.btn-danger {
  background-color: #dc2626;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 16rpx;
}

.btn-danger::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: #1b4b8a;
  border: none;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-ghost::after {
  border: none;
}

.help-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.5;
}

.error {
  color: #dc2626;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.success {
  color: #16a34a;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.header {
  background: #ffffff;
  padding: 32rpx 48rpx 24rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 56rpx;
}

.header-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.body {
  padding: 24rpx 32rpx 48rpx;
}

.card {
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2937;
}

.card-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.continue-card {
  background: #e8f0f8;
  border: 2rpx solid #1b4b8a;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.continue-icon,
.mode-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.mode-icon {
  margin-bottom: 16rpx;
}

.continue-copy {
  flex: 1;
  min-width: 0;
}

.bank-top {
  display: flex;
  align-items: center;
}

.bank-title {
  flex: 1;
  min-width: 0;
}

.continue-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1b4b8a;
}

.continue-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.chevron {
  font-size: 40rpx;
  color: #9ca3af;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: #f0fdf4;
  color: #16a34a;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
}

.grid-item {
  width: 50%;
  box-sizing: border-box;
  padding: 12rpx;
}

.mode-card {
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  min-height: 200rpx;
}

.mode-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2937;
}

.mode-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.menu {
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.menu-item + .menu-item {
  border-top: 2rpx solid #f3f4f6;
}

.menu-copy {
  flex: 1;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2937;
}

.menu-title.danger {
  color: #dc2626;
}

.menu-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.stub {
  color: #6b7280;
  font-size: 26rpx;
  padding: 24rpx 0;
}

.notice {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #fff8e6;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #856404;
}
