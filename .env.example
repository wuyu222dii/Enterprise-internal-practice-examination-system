# Copy to `.env` or export. Do not commit real values.

# Storage: local (dev default) or minio (docker / production)
EXAM_STORAGE_BACKEND=local
EXAM_MINIO_ENDPOINT=http://localhost:19000
EXAM_MINIO_ACCESS_KEY=minioadmin
EXAM_MINIO_SECRET_KEY=minioadmin
EXAM_STORAGE_BUCKET=exam-files

# SMS: mock | aliyun | tencent
EXAM_SMS_PROVIDER=mock
EXAM_SMS_WEBHOOK_URL=
EXAM_SMS_ALIYUN_ACCESS_KEY_ID=
EXAM_SMS_ALIYUN_ACCESS_KEY_SECRET=
EXAM_SMS_ALIYUN_SIGN_NAME=
EXAM_SMS_ALIYUN_TEMPLATE_CODE=
EXAM_SMS_TENCENT_SECRET_ID=
EXAM_SMS_TENCENT_SECRET_KEY=
EXAM_SMS_TENCENT_SDK_APP_ID=
EXAM_SMS_TENCENT_SIGN_NAME=
EXAM_SMS_TENCENT_TEMPLATE_ID=

# WeChat mini program. mock-openid=true skips code2Session (local/CI).
EXAM_WECHAT_MOCK_OPENID=true
EXAM_WECHAT_APP_ID=
EXAM_WECHAT_APP_SECRET=
